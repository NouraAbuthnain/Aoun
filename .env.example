# OpenAI API key
# Copy this file to .env and replace the placeholder with your own key.
# Never commit the real .env file.
OPENAI_API_KEY=your_openai_api_key_here

# Main text model
# Reserved for clinical extraction, suggestions, feedback,
# and future language-processing features.
OPENAI_MODEL=gpt-4.1-mini

# Speech-to-text model
# Used to convert recorded clinical notes into editable text.
OPENAI_STT_MODEL=gpt-4o-mini-transcribe

# Text-to-speech model
# Reserved for future spoken feedback and accessibility features.
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Voice used for text-to-speech
OPENAI_TTS_VOICE=coral

# Local SQLite database
# Stores reviewed and submitted demonstration claims.
DATABASE_URL=sqlite:///./aoun.db